<header class="mobile-topbar">
  <button type="button" class="mobile-nav-toggle" aria-label="Open menu" aria-expanded="false" onclick="document.querySelector('.sidebar').classList.add('open'); document.querySelector('.sidebar-overlay').classList.add('open');">
    <span></span><span></span><span></span>
  </button>
  <a href="/schedule" class="mobile-brand">
    <%- include('pin-icon') %>
    <span>workweek</span>
  </a>
</header>

<div class="sidebar-overlay" onclick="document.querySelector('.sidebar').classList.remove('open'); this.classList.remove('open');"></div>

<aside class="sidebar">
  <a href="/schedule" class="sidebar-brand">
    <%- include('pin-icon') %>
    <span>workweek</span>
  </a>

  <nav onclick="document.querySelector('.sidebar').classList.remove('open'); document.querySelector('.sidebar-overlay').classList.remove('open');">
    <a href="/employees" class="<%= active === 'employees' ? 'active' : '' %>">Employees</a>
    <a href="/clients" class="<%= active === 'clients' ? 'active' : '' %>">Clients</a>
    <a href="/routes" class="<%= active === 'routes' ? 'active' : '' %>">Routes</a>
    <a href="/revenue" class="<%= active === 'revenue' ? 'active' : '' %>">Revenue</a>
    <a href="/messages" class="<%= active === 'messages' ? 'active' : '' %>">Messages</a>
    <a href="/schedule" class="<%= active === 'schedule' ? 'active' : '' %>">Schedule</a>
  </nav>

  <div class="sidebar-footer">
    <span class="business-name"><%= businessName %></span>
    <form action="/logout" method="POST">
      <button type="submit">Log out</button>
    </form>
  </div>
</aside>
